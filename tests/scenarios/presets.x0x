# Penumbra's preset songs (app/presets.c), each loaded as GLO > PRESET SONGS does and played from P1
# (PLAY loops P1-P4) for about two patterns, into build/scenarios/presets/preset_N.wav: each must make
# sound, and none may clip. The level each preset leaves the outputs at is listed in the log.
wait 300
preset 1
wav preset_1.wav
peakreset
tap PLAY
wait 27000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
# from the menu, as on the FM-1: GLO > PRESET SONGS > IMBRIUM (the third row), asked, then loaded
wait 3000
tap GLO
turn SELECT 2
tap SEL
tap SEL
wait 200
expect sound0.11.0 7
expect sound0.0.0 24
expect sound0.3.0 36
shot preset_menu.png
wait 6000
preset 2
wav preset_2.wav
peakreset
tap PLAY
wait 32000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
wait 9000
preset 3
wav preset_3.wav
peakreset
tap PLAY
wait 20000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
wait 6000
preset 4
wav preset_4.wav
peakreset
tap PLAY
wait 23000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
wait 6000
preset 5
wav preset_5.wav
peakreset
tap PLAY
wait 18000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
wait 6000
preset 6
wav preset_6.wav
peakreset
tap PLAY
wait 3000
tapkey b2
tapkey b3
wait 16000
expect peak_db_min -30
expect peak_db_max -0.5
tap PLAY
wavstop
