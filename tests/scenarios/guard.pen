# The overload guard thins the drones past 92% and gives them back after 3 s under 65%, by a fade (no
# click: guard.wav, checked by ear and by tests/click_check.py)
wait 300
tapkey b0
tapkey b1
tapkey b3
wait 4000
wav guard.wav
load 95
wait 100
expect guard 1
load 40
wait 4000
expect guard 0
expect guardcount 1
wavstop
