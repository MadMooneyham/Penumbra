# Penumbra's screens in the shared layout (header, main area, knob strip): HOME's eclipse stopped
# and playing a preset, a part's sound page, the mixer, GLOBAL's list
wait 300
tap HOME
wait 300
shot home_stopped.png
preset 1
tap PLAY
wait 9000
shot home_playing.png
wait 7000
shot home_playing2.png
tap EDIT
wait 300
shot part_drone.png
tap LFO
wait 300
shot mix.png
tap GLO
wait 300
shot global.png
tap HOME
tap PLAY
wait 3000
expect peak_db_max -0.5
