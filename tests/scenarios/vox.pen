# The white keys play VOX in A minor, four voices: a chord, a fifth note taking a voice, OCT moving the
# keys; MIDI notes on channel 1 too (channel 2 not). Released, it and its echoes fall away
autoplay 0
wait 300
expect vox 0
wav vox.wav
key w0 down
wait 300
key w2 down
wait 300
key w4 down
wait 300
key w6 down
wait 1500
expect vox 1
expect peak_db_min -30
key w7 down
wait 1500
key w0 up
key w2 up
key w4 up
key w6 up
key w7 up
wait 400
tap OCT+
tapkey w4
wait 800
# let go: the notes fall away (RELEASE, about a second a step of 8.7 dB), their shimmer and echoes with them
wait 9500
expect vox 0
peakreset
wait 1000
expect peak_db_max -45
midi 90 39 64
wait 600
expect vox 1
expect peak_db_min -40
midi 80 39 00
wait 9500
expect vox 0
midi 91 39 64
wait 400
expect vox 0
wavstop
expect clips 0
