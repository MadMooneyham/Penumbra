# AUTOSAVE (default ON): unsaved changes are saved by themselves while stopped, once nothing has been
# touched for 4 s and the output has been silent for 1 s, writing only the objects that changed; never
# while playing; never when OFF.
wait 300
expect store_writes 0
# DR1 on steps 1 and 9, stopped (its black key also latches it on: it sounds)
tapkey b0
tapkey w0
tapkey w8
wait 3000
expect store_writes 0
wait 1500
# Penumbra: not under a sounding drone (the flash erase would be a crackle in it)
expect store_writes 0
tapkey b0
wait 40000
# let go and faded out: the first save writes every object (nothing was on the flash yet)
expect store_writes 6
reboot
expect hit0.0.0 1
expect hit0.0.8 1
# one more step: only the patterns' object changes, so one write
wait 21000
tapkey w4
wait 4500
expect store_writes 7
# the drone's steps off again (played, each hit would toggle DR1's latch: it could ring on after STOP)
wait 21000
tapkey w0
tapkey w4
tapkey w8
wait 4500
expect store_writes 8
# playing (the 808 now): an edit is not saved, however long it waits
turn ALGO 1
tap PLAY
tapkey w12
wait 8000
expect store_writes 8
tap PLAY
wait 4500
expect store_writes 8
wait 20000
expect store_writes 9
expect hit1.0.12 1
# GLO > AUTOSAVE OFF (the twentieth row, after the six PRESET SONGS): saved once more (the setting itself),
# then edits wait for SAVE
wait 21000
tap GLO
turn SELECT 19
turn ALGO -1
tap HOME
wait 5000
expect store_writes 10
tapkey w2
wait 25000
expect store_writes 10
reboot
expect hit0.0.2 0
tapkey w2
wait 25000
expect store_writes 10
