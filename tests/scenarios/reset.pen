# RESET: SHAPE's SEL (twice) puts the page shown back as made (DRONE with its voices' own; VOX's pages the
# sound playing); SYSTEM > RESET SOUND (SEL twice) Penumbra as a new unit, its settings aside: the journey a
# new unit plays (all of it), the FX page, the user journeys and the sound library empty, the loop and A/B gone,
# a throw kept let go. The tempo and SYSTEM's settings stay. Once alone does nothing.
autoplay 0
wait 300
key b2 down
turn K2 -5
key b2 up
expect dvoice32 65
tap ENV
turn K1 10
expect shape11 95
tap SEL
wait 100
expect shape11 95
shot reset_ask.png
tap SEL
wait 100
expect shape11 75
expect dvoice32 75
turn SELECT 2
turn K1 8
expect vs1.1 80
tap SEL
wait 4000
tap SEL
wait 100
expect vs1.1 80
tap SEL
wait 100
expect vs1.1 64
tap ENV
turn K2 6
expect vs1.7 12
tap FX
turn K1 -4
expect fx0 83
tap HOME
# (the SPACE macro, by its CC: HOME's knobs are its pages now)
midi B0 10 36
wait 100
expect macro3 54
press FX
turn K3 10
tap SAVE
release FX
wait 100
expect perf2 40
# things of the player's own: a user journey, a library sound, a loop, an A
tap LFO
turn PRESET 7
tap SAVE
expect slot1 1
tap LFO
tap SAVE
expect snd1 1
tap HOME
tap REC
tapkey w2
tap REC
wait 200
expect looper 2
press ENV
tap OCT-
release ENV
expect ab_have 1
tap GLO
turn ALGO 5
expect set_bpm 95
turn SELECT 13
tap SEL
wait 100
expect vs1.7 12
tap SEL
wait 100
expect vs1.7 0
expect fx0 91
expect macro3 64
expect perf2 0
expect set_bpm 95
expect nscenes 4
expect slot1 0
expect snd1 0
expect ab_have 0
expect journey 1
wait 200
expect looper 0
expect clips 0
