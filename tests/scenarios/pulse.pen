# PULSE: black key 6 hits the kick, 7 the tick, by hand only: over the drones and with the clock
# running nothing else plays it. No clicks, no clips.
autoplay 0
wait 300
wav pulse.wav
tapkey b5
wait 600
expect kicks 1
tapkey b6
wait 600
expect kicks 1
expect peak_db_min -30
tap SEQ
wait 8000
expect kicks 1
tapkey b5
wait 500
tapkey b5
wait 500
expect kicks 3
shot pulse.png
tap SEQ
wait 3000
wavstop
expect clips 0
