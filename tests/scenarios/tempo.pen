# ALGO is the tempo; it is saved and the clock follows it. The save waits for the output to
# fall quiet (PULSE's kicks ring a few seconds after STOP)
autoplay 0
wait 300
turn ALGO 30
expect set_bpm 120
tap SEQ
wait 2000
expect clocks_out >88
expect clocks_out <102
tap SEQ
wait 3000
expect dirty 1
wait 35000
expect dirty 0
reboot
wait 300
expect set_bpm 120
